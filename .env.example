# ---------------------------------------------------------------- app
# Public URL as served by your reverse proxy (HTTPS required for OIDC and iOS PWA)
APP_BASE_URL=https://finn.example.com
# Long random string: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Host interface / port the container is published on (your reverse proxy targets this)
APP_BIND=127.0.0.1
APP_PORT=8080
DEFAULT_LOCALE=fr
BASE_CURRENCY=CHF
# IPs of your reverse proxy allowed to set X-Forwarded-* headers ("*" trusts everyone reaching the port)
FORWARDED_ALLOW_IPS=*

# ---------------------------------------------------------------- database
POSTGRES_USER=finn
POSTGRES_PASSWORD=
POSTGRES_DB=finn

# ---------------------------------------------------------------- authentication (OIDC / authentik)
# oidc | disabled  (disabled = no login, single local user; only for local testing!)
AUTH_MODE=oidc
# authentik: Applications > Providers > OAuth2/OpenID provider > "OpenID Configuration Issuer"
OIDC_ISSUER=https://auth.example.com/application/o/finn/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
# Optional restrictions (comma separated). Empty = any user authentik lets through.
OIDC_ALLOWED_GROUPS=
OIDC_ALLOWED_EMAILS=

# ---------------------------------------------------------------- AI (any OpenAI-compatible API)
# e.g. https://api.openai.com/v1 , http://ollama:11434/v1 , https://openrouter.ai/api/v1
AI_BASE_URL=
AI_API_KEY=
# text model used to classify transactions
AI_TEXT_MODEL=
# vision-capable model used to read receipts (images / PDFs)
AI_VISION_MODEL=
AI_TIMEOUT=60
AI_MAX_CONCURRENCY=4
