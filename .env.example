# ---------------------------------------------------------------- app
# Public URL as served by your reverse proxy (HTTPS required for OIDC and iOS PWA)
APP_BASE_URL=https://finn.example.com
# Long random string: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Host interface / port the container is published on (your reverse proxy targets this)
APP_BIND=127.0.0.1
APP_PORT=8080
DEFAULT_LOCALE=fr
BASE_CURRENCY=CHF
# IPs of your reverse proxy allowed to set X-Forwarded-* headers ("*" trusts everyone reaching the port)
FORWARDED_ALLOW_IPS=*

# ---------------------------------------------------------------- database
POSTGRES_USER=finn
# letters and digits only (it is embedded in the database URL)
POSTGRES_PASSWORD=
POSTGRES_DB=finn

# ---------------------------------------------------------------- authentication (OIDC / authentik)
# oidc | disabled  (disabled = no login, single local user; only for local testing!)
AUTH_MODE=oidc
# authentik: Applications > Providers > OAuth2/OpenID provider > "OpenID Configuration Issuer"
OIDC_ISSUER=https://auth.example.com/application/o/finn/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
# Optional restrictions (comma separated). Empty = any user authentik lets through.
OIDC_ALLOWED_GROUPS=
OIDC_ALLOWED_EMAILS=

# ---------------------------------------------------------------- AI (any OpenAI-compatible API)
# e.g. https://api.openai.com/v1 , http://ollama:11434/v1 , https://openrouter.ai/api/v1
AI_BASE_URL=
AI_API_KEY=
# text model used to classify transactions
AI_TEXT_MODEL=
# vision-capable model used to read receipts (images / PDFs)
AI_VISION_MODEL=
AI_TIMEOUT=60
AI_MAX_CONCURRENCY=4

# --- MCP server (AI assistants: Claude, ChatGPT, Cursor...) at <APP_BASE_URL>/mcp ----------
# Clients authenticate with a personal access token created in Settings.
MCP_ENABLED=true
# Also accept OAuth access tokens issued by authentik for this app (claude.ai custom connectors):
# add the client's callback URL (e.g. https://claude.ai/api/mcp/auth_callback) to the provider's
# redirect URIs and give the connector the same client ID / secret.
MCP_OAUTH=false
# Expected "aud" of those tokens; defaults to OIDC_CLIENT_ID
MCP_OAUTH_AUDIENCE=

# Merchant logos: fetched by the server from the merchant's website and cached in the database.
MERCHANT_LOGOS=true
# Many shops block automated requests; "duckduckgo" then asks icons.duckduckgo.com (it only sees the
# shop's domain, e.g. migros.ch). "none" = only the merchant's own website.
MERCHANT_LOGO_FALLBACK=duckduckgo
